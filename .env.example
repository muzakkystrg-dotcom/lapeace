# Kunci API Google Stitch SDK
STITCH_API_KEY=your_stitch_api_key_here

# Kunci Enkripsi JWT & Autentikasi Sesi Warga
SITAPAK_JWT_SECRET=generate_strong_64char_random_hex_for_production_jwt_here

# Master Kunci Enkripsi Kolom PII AES-256-GCM (Tepat 32 bytes)
SITAPAK_PII_ENCRYPTION_KEY=generate_strong_32bytes_random_key_for_aes256_here

# Port Server Backend NestJS
PORT=3000
