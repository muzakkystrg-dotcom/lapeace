# Server Environment & Port
PORT=3001
NODE_ENV=development

# Kunci Enkripsi JWT & Autentikasi Sesi Warga (Minimal 32 karakter acak)
SITAPAK_JWT_SECRET=your_jwt_secret_here_min_32_characters

# Master Kunci Enkripsi Kolom PII AES-256-GCM (32 bytes / 64 karakter hex)
SITAPAK_PII_ENCRYPTION_KEY=your_aes_256_encryption_key_here_32_bytes_hex
